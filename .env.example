APP_NAME=企业知识库问答助手
LLM_PROVIDER=deepseek
EMBEDDING_PROVIDER=local

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local model path
EMBEDDING_MODEL_DIR=./models/bge-large-zh-v1.5
RERANKER_MODEL_DIR=./models/bge-reranker-large

# Local runtime paths
UPLOAD_DIR=./backend/data/uploads
FAISS_INDEX_PATH=./backend/data/faiss_index.bin
RETRIEVAL_TOP_K=10
RERANK_TOP_K=10
HYBRID_ALPHA=0.5
